{
  "name": "kerala-athaan-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Kerala Athaan: Transparent, offline-first Islamic prayer time & calendar platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "2.1.5",
    "eslint": "^9.15.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^3.23.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
